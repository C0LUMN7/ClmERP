[api_envi]
#以实际路径为准
host = http://你的服务器地址/jshERP-boot

[MYSQL]
host = 你的MySQL地址
port = 3306
username = jsh_erp
password = 数据库密码
database = jsh_erp

[EMAIL]
host = smtp.163.com
port = 25
user = 发件人邮箱地址
passwd = 邮箱授权码
addressee = 收件邮箱地址，多个以;隔开
subject = 接口测试

[DINGTALK]
# 钉钉机器人 Webhook 地址（含 access_token）
webhook = https://oapi.dingtalk.com/robot/send?access_token=你的token
# 钉钉机器人加签密钥（如果开启加签）
secret = 你的密钥

[REPORT_TYPE]
type = allure
