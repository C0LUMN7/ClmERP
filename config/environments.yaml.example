# 最小多环境配置模板
# 用法：复制为 config/environments.yaml 后按需填写；敏感值优先使用环境变量注入，
# 禁止提交真实账号密码。当前读取逻辑以环境变量为主，本文件作为结构模板与说明。
system:
  name: jshERP
  repository: https://github.com/jishenghua/jshERP
  environment: cloud_test          # cloud_test | local，切换环境请同步 ERP_ENV
  deployed_version: ${ERP_VERSION} # 云端测试实例部署版本，无法确认时留待确认
  # deployed_commit: 待确认        # 可选，能够确认时再填写

environments:
  cloud_test:
    api_url: ${ERP_API_URL}
    ui_url: ${ERP_UI_URL}
    mysql:
      host: ${MYSQL_HOST}
      port: ${MYSQL_PORT}
      username: ${MYSQL_USERNAME}
      password: ${MYSQL_PASSWORD}
      database: ${MYSQL_DATABASE}
    login:
      username: ${ERP_USERNAME}
      password: ${ERP_PASSWORD}
    business_ids:
      category_id: ${ERP_CATEGORY_ID}          # 商品分类 ID（cloud_test 默认示例 91）
      depot_id: ${ERP_DEPOT_ID}                # 默认仓库 ID（cloud_test 默认示例 124）
      supplier_organ_id: ${ERP_SUPPLIER_ORGAN_ID}  # 供应商（cloud_test 默认示例 196）
      customer_organ_id: ${ERP_CUSTOMER_ORGAN_ID}  # 客户（cloud_test 默认示例 204）
      settle_account_id: ${ERP_SETTLE_ACCOUNT_ID}  # 单据结算账户（cloud_test 默认示例 86）
      finance_account_id: ${ERP_FINANCE_ACCOUNT_ID}  # 收付款财务账户（cloud_test 默认示例 105）

  local:
    # 与 cloud_test 使用同一组环境变量；本地环境请覆盖 ERP_* / MYSQL_* 环境变量
    api_url: ${ERP_API_URL}
    ui_url: ${ERP_UI_URL}
    mysql:
      host: ${MYSQL_HOST}
      port: ${MYSQL_PORT}
      username: ${MYSQL_USERNAME}
      password: ${MYSQL_PASSWORD}
      database: ${MYSQL_DATABASE}
    login:
      username: ${ERP_USERNAME}
      password: ${ERP_PASSWORD}
    business_ids:
      category_id: ${ERP_CATEGORY_ID}
      depot_id: ${ERP_DEPOT_ID}
      supplier_organ_id: ${ERP_SUPPLIER_ORGAN_ID}
      customer_organ_id: ${ERP_CUSTOMER_ORGAN_ID}
      settle_account_id: ${ERP_SETTLE_ACCOUNT_ID}
      finance_account_id: ${ERP_FINANCE_ACCOUNT_ID}
