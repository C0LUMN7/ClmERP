[system]
environment = cloud_test
deployed_version = 管伊佳ERP V3.6

[api_envi]
# 后端 API 根地址，以实际路径为准
host = http://你的服务器地址/jshERP-boot
# 前端根地址，不带登录后的路由
ui_host = http://你的服务器地址

[LOGIN]
username = ERP登录账号
password = ERP登录明文密码

[MYSQL]
host = 你的MySQL地址
port = 3306
username = jsh_erp
password = 数据库密码
database = jsh_erp

[BUSINESS_IDS]
category_id = 商品分类ID
depot_id = 默认仓库ID
supplier_organ_id = 供应商ID
customer_organ_id = 客户ID
settle_account_id = 单据结算账户ID
finance_account_id = 收付款财务账户ID

[UI]
# 登录成功判断条件：必须来自真实 jshERP 页面资料（人工确认的登录后目标 URL、
# 页面标题或稳定可见元素），不能猜测填写
# login_success_kind 支持 url / title / text
# 两项默认留空：留空时 preflight 标记“待确认”，UI 冒烟用例会跳过，
# 复制本模板后不会被误判为已配置
login_success_kind =
login_success_value =

[REPORT_TYPE]
type = allure

[EMAIL]
host = smtp.163.com
port = 465
user = 发件人邮箱地址
passwd = 邮箱授权码
addressee = 收件邮箱地址，多个以;隔开
subject = 接口测试

[DINGTALK]
# 钉钉机器人 Webhook 地址（含 access_token）
webhook = 钉钉机器人Webhook地址
# 钉钉机器人加签密钥（如果开启加签）
secret = 钉钉机器人加签密钥
