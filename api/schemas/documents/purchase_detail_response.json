{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "采购入库单详情响应契约",
  "description": "校验 /depotHead/getDetailByNumber 响应中框架依赖的关键字段：id、number、type、organId、totalPrice、debt",
  "type": "object",
  "required": ["code", "data"],
  "properties": {
    "code": {
      "type": "integer",
      "description": "业务状态码，200 表示成功"
    },
    "data": {
      "type": "object",
      "required": ["id", "number", "type", "organId", "totalPrice", "debt"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "单据 ID，审核和收付款接口依赖"
        },
        "number": {
          "type": "string",
          "description": "单据编号"
        },
        "type": {
          "type": "string",
          "description": "单据类型，采购入库为 入库"
        },
        "organId": {
          "type": "integer",
          "description": "往来单位（供应商/客户）ID"
        },
        "totalPrice": {
          "type": "number",
          "description": "单据总金额"
        },
        "debt": {
          "type": "number",
          "description": "欠款金额"
        }
      }
    }
  }
}
